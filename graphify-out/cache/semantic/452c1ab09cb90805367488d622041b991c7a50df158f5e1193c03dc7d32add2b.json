o2_incompatible", "target": "tfg_models_new_server", "relation": "incompatible_with", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "122:124", "weight": 1.0}, {"source": "tfg_models_env_management", "target": "tfg_models_vexpress", "relation": "motivated_by", "confidence": 0.85, "confidence_score": 0.85, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "164:167", "weight": 0.85}, {"source": "tfg_models_common_bugs", "target": "tfg_models_vexpress", "relation": "discovered_via", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "103:106", "weight": 1.0}, {"source": "tfg_models_weight_download_strategies", "target": "tfg_models_new_server", "relation": "applied_to", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "159:162", "weight": 1.0}, {"source": "tfg_models_cuda_compatibility", "target": "tfg_models_old_server", "relation": "documents_case_for", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "176:181", "weight": 1.0}, {"source": "tfg_models_cuda_compatibility", "target": "tfg_models_new_server", "relation": "documents_case_for", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "176:181", "weight": 1.0}, {"source": "tfg_models_wav2lip", "target": "tfg_models_syncnet_metric", "relation": "evaluated_by", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "131:131", "weight": 1.0}, {"source": "tfg_models_musetalk", "target": "tfg_models_syncnet_metric", "relation": "evaluated_by", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "132:132", "weight": 1.0}, {"