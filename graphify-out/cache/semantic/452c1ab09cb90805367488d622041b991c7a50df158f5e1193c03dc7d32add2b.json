{"nodes": [{"id": "tfg_models_musetalk", "label": "MuseTalk 1.5", "file_type": "code", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "46:55", "description": "Version 1.5 of MuseTalk (2025-03-28 release) with two-stage training and spatial-temporal sampling. Uses VAE latent + multi-scale U-Net inpainting architecture. Outputs 256x256 face regions.", "metadata": {"version": "1.5", "release_date": "2025-03-28", "resolution": "256x256", "architecture": "VAE latent + multi-scale U-Net inpainting", "inference_time": "~90s per video", "vram": "~8.4 GB", "publication": "arXiv 2410.10122", "code_release": "2024-04"}}, {"id": "tfg_models_latentsync", "label": "LatentSync", "file_type": "code", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "61:71", "description": "ByteDance latent diffusion model for lip-sync. Uses Whisper tiny encoder + UNet diffusion. Outputs 512x512. Release date 2024-12-12.", "metadata": {"organization": "ByteDance", "resolution": "512x512", "architecture": "Latent diffusion model", "inference_time": "~2m50s per video", "vram": "~3.5 GB peak", "release_date": "2024-12-12", "weight_size": "latentsync_unet.pt 4.8GB, Whisper tiny 73MB", "env": "latentsync conda env (torch 2.6.0+cu124)"}}, {"id": "tfg_models_joyvasa", "label": "JoyVASA", "file_type": "code", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "77:87", "description": "Diffusion Transformer model using LivePortrait backbone. Uses HuBERT audio encoder. Very fast inference (~23s per video). Published arXiv 2411.09209.", "metadata": {"resolution": "512x512", "architecture": "Diffusion Transformer (LivePortrait backbone)", "inference_time": "~23s per video", "vram": "~2.2 GB", "publication": "arXiv 2411.09209", "release_date": "2024-11-14", "weight_size": "2.6GB total: motion_generator 414MB + HuBERT 361MB + LivePortrait 628MB", "env": "joyvasa conda env (torch 2.4.1+cu124)"}}, {"id": "tfg_models_vexpress", "label": "V-Express", "file_type": "code", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "91:101", "description": "Tencent AI Lab progressive dropout diffusion model with keypoint-based approach. Slowest successful model (~6m20s per video). Published arXiv 2406.02511.", "metadata": {"organization": "Tencent AI Lab", "resolution": "512x512", "architecture": "Progressive dropout diffusion model + keypoints", "inference_time": "~6m20s per video", "vram": "~9 GB", "publication": "arXiv 2406.02511", "release_date": "2024-06-04", "weight_size": "6GB: denoising_unet 2.6G + reference_net 1.7G + motion_module 867M", "env": "reuses latentsync conda env (torch 2.6.0+cu124)"}}, {"id": "tfg_models_echomimic_abandoned", "label": "EchoMimic", "file_type": "code", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "110:113", "description": "Abandoned model: extremely slow inference (5.6h/sample without xformers). Weights downloaded but infeasible to use.", "metadata": {"status": "abandoned", "reason": "Inference too slow (5.6h/sample without xformers)"}}, {"id": "tfg_models_aniportrait_abandoned", "label": "AniPortrait", "file_type": "code", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "115:118", "description": "Abandoned model: 256x256 fp16 still OOM (~9.8GB). Weights 10GB+ downloaded but cannot perform inference.", "metadata": {"status": "abandoned", "reason": "OOM even at 256x256 fp16 (~9.8GB), model too heavy"}}, {"id": "tfg_models_hallo2_incompatible", "label": "Hallo2", "file_type": "code", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "120:124", "description": "ICLR 2025 model for 4K long-duration generation, best quality. Incompatible due to CUDA 11.8 hard requirement (server has CUDA 13.0) and English-only limitation.", "metadata": {"venue": "ICLR 2025", "status": "incompatible", "reason": "CUDA 11.8 hard requirement, English-only"}}, {"id": "tfg_models_old_server", "label": "Old Server (1080 Ti x8)", "file_type": "concept", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "5:11", "description": "GPU server with 8x GTX 1080 Ti (11GB, Pascal CC 6.1), driver 470.103.01 (CUDA 11.4 max), Ubuntu 20.04.3, 157GB RAM. Hosts Wav2Lip and MuseTalk 1.5.", "metadata": {"ip": "10.1.114.114:1986", "gpu": "8x GTX 1080 Ti (11GB)", "cuda": "11.4 max", "os": "Ubuntu 20.04.3", "ram": "157GB", "disk": "HDD /data/wjj/"}}, {"id": "tfg_models_new_server", "label": "New Server (RTX 4080 SUPER)", "file_type": "concept", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "13:20", "description": "GPU server with 1x RTX 4080 SUPER (32GB, Ada CC 8.9), driver 580.105.08 (CUDA 13.0), Ubuntu 22.04, 503GB RAM. Hosts LatentSync, JoyVASA, V-Express.", "metadata": {"hostname": "connect.westd.seetacloud.com:14453", "gpu": "1x RTX 4080 SUPER (32GB)", "cuda": "13.0", "os": "Ubuntu 22.04", "ram": "503GB", "disk": "/root/autodl-tmp/ 50GB XFS"}}, {"id": "tfg_models_eval_server", "label": "Evaluation Server (20398)", "file_type": "concept", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "22:26", "description": "GPU server specifically for SyncNet evaluation. 1x RTX 4080 SUPER (32GB). Previously served as master control server for experiments.", "metadata": {"hostname": "connect.westd.seetacloud.com:20398", "gpu": "1x RTX 4080 SUPER (32GB)", "purpose": "SyncNet evaluation", "envs": "syncnet, ditto conda envs"}}, {"id": "tfg_models_syncnet_metric", "label": "SyncNet Evaluation Metrics", "file_type": "concept", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "142:153", "description": "Sync-C (confidence, higher better) and Sync-D (distance, lower better) metrics for lip-sync quality evaluation. Computed with SyncNet on evaluation server 20398 using 04_eval.py.", "metadata": {"sync_c_description": "Confidence score, higher is better", "sync_d_description": "Min distance, lower is better", "eval_script": "04_eval.py", "wav2lip_natural_sync_c": 7.393, "wav2lip_natural_sync_d": 7.327, "wav2lip_tts_sync_c": 8.922, "wav2lip_tts_sync_d": 5.941}}, {"id": "tfg_models_syncnet_rankings", "label": "SyncNet Model Rankings", "file_type": "concept", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "145:153", "description": "Ranked lip-sync performance: Wav2Lip (best, Sync-C 7.393), V-Express (Sync-C 5.975), MuseTalk 1.5 (Sync-C 5.789), JoyVASA (Sync-C 4.815), LatentSync (Sync-C 4.653). All models show higher Sync-C under TTS conditions.", "metadata": {"finding": "All models show higher Sync-C under TTS conditions than natural, because TTS is cleaner for lip detection", "top_model": "Wav2Lip"}}, {"id": "tfg_models_weight_download_strategies", "label": "Weight Download Strategies", "file_type": "rationale", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "159:162", "description": "Strategies for downloading model weights in network-restricted environments: (1) hf-mirror.com priority, (2) SeetaCloud proxy source /etc/network_turbo, (3) local download + SCP for large files >1GB.", "metadata": {"priority_1": "hf-mirror.com (no proxy needed)", "priority_2": "source /etc/network_turbo (SeetaCloud proxy, unstable)", "priority_3": "Local download + SCP (most reliable, for >1GB files)"}}, {"id": "tfg_models_env_management", "label": "Environment Isolation & Reuse", "file_type": "rationale", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "164:167", "description": "Best practices for conda environment management: prefer independent env per model but reuse when possible (e.g., V-Express reuses latentsync env), avoid pip install cascade upgrades of PyTorch, use Tsinghua PyPI mirror for pip installs.", "metadata": {"pypi_mirror": "https://pypi.tuna.tsinghua.edu.cn/simple"}}, {"id": "tfg_models_common_bugs", "label": "Common Code Bug Fixes", "file_type": "rationale", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "183:186", "description": "Template fixes for common issues: (1) torch.load weights_only=True default in PyTorch >=2.6, (2) str.replace() path traps with filenames containing digits, (3) conda GraalPy incompatibility with native extensions.", "metadata": {}}, {"id": "tfg_models_cuda_compatibility", "label": "PyTorch-CUDA Compatibility Matrix", "file_type": "rationale", "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "176:181", "description": "Compatibility guide: CUDA 11.4 (470 driver) -> PyTorch 2.0.1+cu118 for GTX 1080 Ti; CUDA 12.4+ -> PyTorch 2.4.1+cu124 for RTX 4080; CUDA 13.0 -> PyTorch 2.6.0+cu124 (compatible with CUDA 12.4 binaries).", "metadata": {}}], "edges": [{"source": "tfg_models_wav2lip", "target": "tfg_models_syncnet_rankings", "relation": "ranked_best_in", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "146:146", "weight": 1.0}, {"source": "tfg_models_wav2lip", "target": "tfg_models_old_server", "relation": "deployed_on", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "32:42", "weight": 1.0}, {"source": "tfg_models_musetalk", "target": "tfg_models_old_server", "relation": "deployed_on", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "46:56", "weight": 1.0}, {"source": "tfg_models_latentsync", "target": "tfg_models_new_server", "relation": "deployed_on", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "61:71", "weight": 1.0}, {"source": "tfg_models_joyvasa", "target": "tfg_models_new_server", "relation": "deployed_on", "confidence": 1.0, "confidence_score": 1.0, "source_file": "docs/tfg_models/TFG_DEPLOY_SUMMARY.md", "source_location": "77:87", "weight": 1.0}, {"source": "tfg_models_vexpress