+def candidate_rows_context_sha256(plan: Mapping[str, Any]) -> str:
+    contexts = []
+    for source in plan.get("rows", []):
+        row = copy.deepcopy(source)
+        row.pop("method_config_sha256", None)
+        row.get("generation_settings", {}).pop("v3_cli_config_sha256", None)
+        contexts.append(row)
+    return sha_bytes(canonical(contexts))
+
+
+def candidate_method_context_sha256(plan: Mapping[str, Any]) -> str:
+    methods = copy.deepcopy(plan.get("methods", []))
+    for method in methods:
+        method.pop("config_sha256", None)
+        config = method.get("config", {})
+        config.pop("v3_cli_config_path", None)
+        config.pop("v3_cli_config_sha256", None)
+    return sha_bytes(canonical(methods))
 
 
